#!/usr/bin/env bash
set -eo pipefail

declare -r SCRIPT_DIR=$(cd $(dirname $0) >/dev/null 2>&1 && pwd)
source ${SCRIPT_DIR}/common.sh

declare -r tag=$1 container_name=$2 data=$3 config=$4 logs=$5 scripts=$6

# Secret files readable only by root, as with Docker secrets mounted from root-owned 0600 files.
# The entrypoint starts as root and steps down to the influxdb user, which cannot read them.
declare -r secrets=${scripts}/secrets
mkdir -p ${secrets}
printf '%s' ${TEST_USER} > ${secrets}/username
printf '%s' ${TEST_PASSWORD} > ${secrets}/password
printf '%s' ${TEST_ADMIN_TOKEN} > ${secrets}/token
docker run --rm --entrypoint sh -v ${secrets}:/secrets influxdb:${tag} \
    -c 'chown root:root /secrets/* && chmod 600 /secrets/*'

declare -ra docker_run_influxd=(
    docker run -i -d
    --name=${container_name}
    -p 8086:8086
    -v ${data}:/var/lib/influxdb2
    -v ${config}:/etc/influxdb2
    -v ${secrets}:/run/secrets:ro
    -e DOCKER_INFLUXDB_INIT_MODE=setup
    -e DOCKER_INFLUXDB_INIT_USERNAME_FILE=/run/secrets/username
    -e DOCKER_INFLUXDB_INIT_PASSWORD_FILE=/run/secrets/password
    -e DOCKER_INFLUXDB_INIT_ADMIN_TOKEN_FILE=/run/secrets/token
    -e DOCKER_INFLUXDB_INIT_ORG=${TEST_ORG}
    -e DOCKER_INFLUXDB_INIT_BUCKET=${TEST_BUCKET}
    influxdb:${tag} influxd run
)

function check_no_secret_errors () {
    if docker logs ${container_name} 2>&1 | grep -E 'Permission denied|_FILE'; then
        log_msg Error: Unexpected secret file errors $1
        exit 1
    fi
}

function check_token_from_file () {
    local -r orgs=$(curl -s -H "Authorization: Token ${TEST_ADMIN_TOKEN}" localhost:8086/api/v2/orgs | jq -r .orgs[].name)
    if [[ ${orgs} != ${TEST_ORG} ]]; then
        log_msg Error: Bad org list $1
        echo ${orgs}
        exit 1
    fi
}

log_msg Booting 2.x container in setup mode
if ! ${docker_run_influxd[@]} > /dev/null; then
    log_msg Error: Failed to launch container
    exit 1
fi
wait_container_ready

log_msg Checking setup used the secret files
check_token_from_file post-setup
check_no_secret_errors post-setup

log_msg Tearing down 2.x container
docker stop ${container_name} > /dev/null
docker logs ${container_name} > ${logs}/init-docker-stdout.log 2> ${logs}/init-docker-stderr.log
docker rm ${container_name} > /dev/null

# Setup is skipped since the bolt file is present; the secret files must not be read again.
log_msg Booting another 2.x container
if ! ${docker_run_influxd[@]} > /dev/null; then
    log_msg Error: failed to launch container
    exit 1
fi
wait_container_ready

log_msg Checking secret files after recreating container
check_token_from_file "after recreating container"
check_no_secret_errors "after recreating container"
